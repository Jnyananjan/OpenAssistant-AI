# Telegram Bot credentials from @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_WEBHOOK_SECRET=your_telegram_webhook_secret_here

# Google Gemini API Key from Google AI Studio
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# Supabase Credentials
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Application Settings
APP_ENV=development
DEFAULT_TIMEZONE=Asia/Kolkata
MAX_FOLLOW_UPS=8

# Private deployment allowlist (comma-separated numeric Telegram user IDs, or empty to allow all)
ALLOWED_TELEGRAM_USERS=

# Secret token used by Supabase Cron / scheduler to authenticate worker invocations
WORKER_SECRET=your_worker_invocation_secret_here

# 32-character AES-256-GCM Master Encryption Key for per-user provider keys
ENCRYPTION_SECRET=your_32_character_master_encryption_key_here
